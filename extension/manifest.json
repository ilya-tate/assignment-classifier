{
  "manifest_version": 3,
  "name": "Can Plan",
  "version": "0.1.0",
  "description": "Collect Canvas assignments and plan when to start them.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "declarativeContent"],
  "host_permissions": ["http://localhost:8787/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Open Can Plan"}
}
