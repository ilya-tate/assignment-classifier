PORT=8787
# Fill in only these two values, then restart the server.
# Account URL example: https://your-org-your-account.snowflakecomputing.com
# Token: a Snowflake Programmatic Access Token (PAT) with Cortex access.
# Server only. Never copy credentials into the extension.
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_TOKEN=
# Automatic selection: empty credentials = demo; credentials supplied = Snowflake.
INFERENCE_PROVIDER=auto
# Optional override if your account does not allow the default model.
SNOWFLAKE_MODEL=llama3.1-8b
# Assignments per request: 1, 5, or 10. Long inputs split into smaller groups.
INFERENCE_BATCH_SIZE=1
# Optional comma-separated chrome-extension:// origins for a local shared server.
ALLOWED_ORIGINS=

# Private hosted mode (DigitalOcean terminates HTTPS). Leave HOST unset locally.
# HOST=0.0.0.0
# API_ACCESS_KEY=generate-with-openssl-rand-hex-32
# ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
# API_REQUESTS_PER_MINUTE=240
# API_ESTIMATES_PER_HOUR=6
